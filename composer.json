{
    "name": "prestashopheaven/module-kit",
    "description": "Shared base for PrestaHaven PrestaShop modules: ModuleBase trait, module definition, installer, uninstaller, migrations and upgrade helpers.",
    "version": "1.5.0",
    "type": "library",
    "license": "AFL-3.0",
    "authors": [
        {
            "name": "George van Engers",
            "email": "vanengers@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "vanengers/prestashop-library-product-admin-helper": "^1.2"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "prestashopheaven/module-dev-tools": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "PrestaShopHeaven\\ModuleKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrestaShopHeaven\\ModuleKit\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude .cache .",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "ps-module phpstan",
        "compat": "phpcs --standard=phpcs.xml.dist",
        "conventions": "ps-module conventions",
        "test": "phpunit",
        "check": [
            "@lint",
            "@cs",
            "@phpstan",
            "@compat",
            "@conventions",
            "@test"
        ]
    }
}
